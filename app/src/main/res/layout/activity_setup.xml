<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D0E15"
    android:padding="24dp">

    <!-- Центральный блок с логотипом и приветствием -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:gravity="center"
        android:orientation="vertical">

        <!-- Наш неоновый логотип Aura OS -->
        <ImageView
            android:id="@+id/img_logo"
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:src="@drawable/ic_aura_logo" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Aura OS"
            android:textColor="#FFFFFF"
            android:textSize="32sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="Добро пожаловать в вашу новую систему.\nДавайте настроим всё за пару шагов."
            android:textColor="#8E8E9A"
            android:textSize="16sp" />

    </LinearLayout>

    <!-- Кнопка "Начать" внизу экрана -->
    <Button
        android:id="@+id/btn_start"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_alignParentBottom="true"
        android:backgroundTint="#00F2FE"
        android:text="Начать работу"
        android:textColor="#0D0E15"
        android:textSize="18sp"
        android:textStyle="bold" />

</RelativeLayout>

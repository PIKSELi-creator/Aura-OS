<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D0E15">

    <!-- 1. Верхний статус-бар -->
    <LinearLayout
        android:id="@+id/topStatusBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp">

        <TextClock
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:format12Hour="HH:mm"
            android:format24Hour="HH:mm"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@android:drawable/ic_menu_manage"
            app:tint="#00F0FF" />
    </LinearLayout>

    <!-- 2. Сетка всех приложений (RecyclerView) -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/appsRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/topStatusBar"
        android:layout_above="@+id/quickDock"
        android:padding="12dp"
        android:clipToPadding="false" />

    <!-- 3. Нижний Док быстрых кнопок -->
    <LinearLayout
        android:id="@+id/quickDock"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:layout_alignParentBottom="true"
        android:layout_margin="16dp"
        android:background="#151824"
        android:gravity="center"
        android:orientation="horizontal">

        <!-- Кнопка вызова Настроек -->
        <ImageView
            android:id="@+id/dockSettings"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_margin="8dp"
            android:background="#22283A"
            android:padding="10dp"
            android:src="@android:drawable/ic_menu_preferences"
            app:tint="#00F0FF" />

        <!-- Кнопка вызова Шторки Cyber-HUD -->
        <ImageView
            android:id="@+id/dockShade"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_margin="8dp"
            android:background="#22283A"
            android:padding="10dp"
            android:src="@android:drawable/ic_menu_compass"
            app:tint="#FF007A" />

    </LinearLayout>

</RelativeLayout>




